PORT=4000

# ===========================================
# DATABASE CONFIGURATION (Supabase PostgreSQL)
# ===========================================
# 1. Go to your Supabase project dashboard
# 2. Navigate to: Settings > Database > Connection string
# 3. Copy the "URI" connection string and paste it below
# 4. Replace [YOUR-PASSWORD] with your actual database password
#
# OLD (SQLite - now deprecated):
# DATABASE_URL="file:./dev.db"
#
# NEW (Supabase PostgreSQL):
DATABASE_URL="postgresql://postgres.[your-project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection for migrations (optional but recommended)
# DIRECT_URL="postgresql://postgres.[your-project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ===========================================
# API KEYS
# ===========================================
GEMINI_API_KEY="AIzaSy...여기_본인_키_붙여넣기..."